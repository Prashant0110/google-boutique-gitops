<mxfile host="app.diagrams.net" type="device">
<diagram id="09-incident-triage" name="Figure 9 - Incident triage flow for an alert or user report">
<mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="1000" math="0" shadow="0">
<root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="title" value="Figure 9 - Incident triage flow for an alert or user report" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="20" y="8" width="960" height="30" as="geometry"/></mxCell>
<mxCell id="author" value="Prashant Raj Sapkota  |  Apex AI Arabia Cloud DevOps Assessment" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="20" y="38" width="960" height="20" as="geometry"/></mxCell>
<mxCell id="al" value="Alert in Slack or user report" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="350" y="70" width="300" height="50" as="geometry"/></mxCell>
<mxCell id="t1" value="1. Check Argo CD sync and Kubernetes health&lt;br&gt;(kubectl get applications, pods)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="290" y="155" width="420" height="65" as="geometry"/></mxCell>
<mxCell id="t2" value="2. Prometheus and Grafana&lt;br&gt;error rate, latency, traffic, target up" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="290" y="255" width="420" height="65" as="geometry"/></mxCell>
<mxCell id="t3" value="3. Loki logs and Tempo traces&lt;br&gt;for the affected time window" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="290" y="355" width="420" height="65" as="geometry"/></mxCell>
<mxCell id="dec" value="Recent release&lt;br&gt;involved?" style="rhombus;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="350" y="455" width="300" height="95" as="geometry"/></mxCell>
<mxCell id="rbk" value="Run Manual GitOps Rollback&lt;br&gt;service + last good commit SHA&lt;br&gt;review and merge rollback PR" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="610" width="340" height="90" as="geometry"/></mxCell>
<mxCell id="dep" value="Check dependencies and network paths&lt;br&gt;(NetworkPolicy, Vault, Qdrant, RDS)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="600" y="610" width="360" height="80" as="geometry"/></mxCell>
<mxCell id="data" value="Data problem?&lt;br&gt;Restore Qdrant snapshot into an isolated&lt;br&gt;target, verify, then controlled cutover" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;dashed=1;" vertex="1" parent="1"><mxGeometry x="600" y="740" width="360" height="90" as="geometry"/></mxCell>
<mxCell id="ver" value="Verify readiness and user-facing response" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="330" y="870" width="340" height="55" as="geometry"/></mxCell>
<mxCell id="rec" value="Record timeline, impact, mitigation, follow-ups" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="330" y="945" width="340" height="45" as="geometry"/></mxCell>
<mxCell id="e1" value="" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="al" target="t1"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e2" value="" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="t1" target="t2"><mxGeometry relative="1" as="geometry"/></mxCell>
